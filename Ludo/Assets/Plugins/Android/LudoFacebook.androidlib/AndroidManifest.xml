<?xml version="1.0" encoding="utf-8"?>
<!-- Facebook login for Ludo Fight. Only the entries the Facebook SDK for Unity needs, added to the game's own manifest by Gradle
     (the same way the Google Play Games and Amazon plugins do it). The App ID and Client Token are Facebook app "Ludo Fight";
     they are public values (the App Secret is NOT here and must never be). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.devorbit.ludofight.facebook"
    android:versionCode="1"
    android:versionName="1.0">

    <application>
        <activity android:name="com.facebook.unity.FBUnityLoginActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mnc|mcc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|touchscreen"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />
        <activity android:name="com.facebook.unity.FBUnitySSOActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mnc|mcc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|touchscreen"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />
        <activity android:name="com.facebook.unity.FBUnityDialogsActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mnc|mcc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|touchscreen"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />
        <activity android:name="com.facebook.unity.FBUnityGamingServicesFriendFinderActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mnc|mcc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|touchscreen"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />
        <activity android:name="com.facebook.unity.FBUnityAppLinkActivity" android:exported="true" />
        <activity android:name="com.facebook.unity.FBUnityDeepLinkingActivity" android:exported="true" />
        <activity android:name="com.facebook.unity.FBUnityGameRequestActivity" android:exported="false" />

        <meta-data android:name="com.facebook.sdk.ApplicationId" android:value="fb1759980011780675" />
        <meta-data android:name="com.facebook.sdk.ClientToken" android:value="5af5902a078140de3015ba76dccc3f84" />
        <!-- login only: no analytics and no advertising ID (the privacy policy covers login, not tracking) -->
        <meta-data android:name="com.facebook.sdk.AutoLogAppEventsEnabled" android:value="false" />
        <meta-data android:name="com.facebook.sdk.AutoLogProductImprovementEnabled" android:value="false" />
        <meta-data android:name="com.facebook.sdk.AutoLogMetaDataEnabled" android:value="false" />
        <meta-data android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled" android:value="false" />

        <provider android:name="com.facebook.FacebookContentProvider"
            android:authorities="com.facebook.app.FacebookContentProvider1759980011780675"
            android:exported="true" />
    </application>
</manifest>
